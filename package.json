{
  "private": true,
  "version": "0.6.2",
  "engines": {
    "node": ">=v18.0",
    "npm": ">=7.7"
  },
  "scripts": {
    "dev": "pnpm -C packages/app run dev",
    "dev:app": "pnpm -C packages/app run dev",
    "build:app": "pnpm -C packages/app run build",
    "publish:package": "node .github/scripts/publish-package.mjs",
    "test:publish-package": "node --test .github/scripts/publish-package.test.mjs",
    "lint": "eslint --ext js,jsx,ts,vue src/"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-syntax-import-attributes": "^7.28.6",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
