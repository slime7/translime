{
  "name": "translime-plugin-steam-save-backup",
  "version": "1.0.0",
  "description": "Steam 游戏存档备份与还原插件",
  "license": "MIT",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite build -c ui.vite.config.js --watch",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.js",
    "build": "npm run build:plugin && npm run build:ui"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "vite": "^6.3.2",
    "vite-plugin-css-injected-by-js": "^3.1.2",
    "vue": "^3.5.13",
    "vuetify": "^3.8.1"
  },
  "plugin": {
    "title": "Steam Save Backup",
    "description": "备份和还原 Steam 游戏存档",
    "icon": "src/icon.svg",
    "ui": "dist/ui.esm.js"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "vuetify": "^3.8.1"
  }
}