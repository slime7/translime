{
  "name": "translime-plugin-steam-save-backup",
  "version": "1.1.0",
  "description": "Steam 游戏存档备份与还原插件",
  "license": "MIT",
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/icon.svg"
  ],
  "scripts": {
    "dev": "vite build -c ui.vite.config.js --watch --mode preview",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.js",
    "build": "npm run build:plugin && npm run build:ui",
    "preview:plugin": "vite build --mode preview",
    "preview:ui": "vite build -c ui.vite.config.js --mode preview",
    "preview": "npm run preview:plugin && npm run preview:ui"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "~39.2.4",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^3.4.0",
    "vue": "^3.5.13",
    "vuetify": "^3.11.6"
  },
  "plugin": {
    "title": "Steam Save Backup",
    "description": "备份和还原 Steam 游戏存档",
    "icon": "src/icon.svg",
    "ui": "dist/ui.esm.js"
  },
  "peerDependencies": {
    "electron": "~39.2.4",
    "vue": "^3.5.13",
    "vuetify": "^3.11.6"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.8"
  }
}