{
  "$schema": "https://slime7.github.io/translime/translime-plugin.schema.json",
  "name": "translime-plugin-hdr-capture",
  "version": "1.2.1",
  "description": "轻松获取 HDR 截图",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slime7/translime.git",
    "directory": "packages/translime-plugin-hdr-capture"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/main.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/main.cjs.js"
    }
  },
  "engines": {
    "translime": ">=0.7.0"
  },
  "files": [
    "dist",
    "src/assets/icon.png"
  ],
  "napi": {
    "binaryName": "hdr-capture-native",
    "package": {
      "name": "hdr-capture-native"
    },
    "js": true,
    "dts": "index.d.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "dev": "vite build -c ui.vite.config.mjs --watch",
    "preview:ui": "vite -c ui.vite.config.mjs --mode preview",
    "preview:overlay": "vite -c overlay.vite.config.mjs --mode preview",
    "build:native": "napi build --platform --release dist/bin",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.mjs",
    "build:overlay": "vite build -c overlay.vite.config.mjs --mode preload && vite build -c overlay.vite.config.mjs",
    "build:main": "pnpm run build:ui && pnpm run build:plugin && pnpm run build:overlay",
    "build": "rimraf dist && pnpm run build:main && pnpm build:native",
    "test": "pnpm exec vitest run -c vitest.config.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "7.0.3",
    "electron": "~39.2.4",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^10.0.0",
    "mde-vue": "git+https://github.com/slime7/mde-vue.git#f339bf900fe9c525b6a6171553c0ddbfe3fa2bda",
    "rimraf": "^4.4.1",
    "translime-sdk": "workspace:*",
    "vite": "^8.2.0",
    "vite-plugin-css-injected-by-js": "^3.4.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "electron": "~39.2.4",
    "vue": "^3.5.40"
  },
  "plugin": {
    "title": "hdr截图",
    "description": "轻松获取 HDR 截图",
    "icon": "src/assets/icon.png",
    "activationEvents": [
      "onStartup"
    ],
    "dependencies": [],
    "optionalDependencies": [],
    "ui": "dist/ui.esm.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "dayjs": "^1.11.10",
    "tailwindcss": "^4.1.18"
  }
}
