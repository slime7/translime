{
  "name": "translime-sdk",
  "version": "1.0.3",
  "description": "SDK for Translime plugins",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite-plugin.d.ts",
        "default": "./dist/vite-plugin.js"
      },
      "require": {
        "types": "./dist/vite-plugin.d.cts",
        "default": "./dist/vite-plugin.cjs"
      }
    },
    "./preview": {
      "import": {
        "default": "./dist/preview.js"
      },
      "require": {
        "default": "./dist/preview.cjs"
      }
    },
    "./preview-mock": {
      "import": {
        "default": "./dist/preview-mock.js"
      },
      "require": {
        "default": "./dist/preview-mock.cjs"
      }
    }
  },
  "author": "slime7",
  "license": "MIT",
  "keywords": [
    "translime",
    "sdk",
    "plugin",
    "preview"
  ],
  "scripts": {
    "lint": "eslint src --ext .js,.vue --fix",
    "lint:style": "stylelint src/**/*.{vue,scss} --fix",
    "build": "vite build && vite build --mode cjs && node scripts/post-build.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vuetify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@stylistic/stylelint-plugin": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.0.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "postcss-html": "^1.5.0",
    "postcss-scss": "^4.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.0.0",
    "vite": "^8.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vuetify": "^4.1.7"
  }
}
