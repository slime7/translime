{
  "name": "translime-sdk",
  "version": "1.0.1",
  "description": "SDK for Translime plugins",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./vite": {
      "types": "./src/vite-plugin.d.ts",
      "import": "./src/vite-plugin.js",
      "require": "./src/vite-plugin.js",
      "default": "./src/vite-plugin.js"
    },
    "./preview": {
      "import": "./src/preview/main.js",
      "default": "./src/preview/main.js"
    },
    "./preview-mock": {
      "import": "./src/preview-mock.js",
      "default": "./src/preview-mock.js"
    }
  },
  "author": "slime7",
  "license": "MIT",
  "keywords": [
    "translime",
    "sdk",
    "plugin",
    "preview"
  ],
  "scripts": {
    "generate:types": "node scripts/generate-types.js",
    "lint": "eslint src --ext .js,.vue --fix",
    "lint:style": "stylelint src/**/*.{vue,scss} --fix"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vuetify": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@stylistic/stylelint-plugin": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "postcss-html": "^1.5.0",
    "postcss-scss": "^4.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.0.0",
    "vuetify": "^3.11.6"
  }
}