{
  "name": "translime-plugin-google-domains-ddns",
  "version": "1.1.4",
  "description": "谷歌域名动态dns设置",
  "license": "MIT",
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite -c ui.vite.config.mjs",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.mjs",
    "build": "npm run build:plugin && npm run build:ui"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.1.11",
    "autoprefixer": "^10.4.4",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-config-preact": "^1.3.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "jest": "^27.5.1",
    "postcss": "^8.4.12",
    "preact": "^10.6.6",
    "semver-compare": "^1.0.0",
    "tailwindcss": "^3.0.23",
    "tunnel": "^0.0.6",
    "vite": "^8.2.0"
  },
  "plugin": {
    "title": "google domains ddns",
    "description": "定时获取ip并设定为谷歌域名的解析",
    "windowUrl": "dist/ui.html"
  },
  "peerDependencies": {
    "axios": "^1.4.0",
    "preact": "^10.6.6",
    "semver-compare": "^1.0.0",
    "tunnel": "^0.0.6"
  }
}
