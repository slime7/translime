{
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@pkg/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/renderer/*"
      ],
      "@share/*": [
        "./src/share/*"
      ],
      "@main/*": [
        "./src/main/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.vue",
    "src/**/*.css",
    "src/**/*.scss",
    "src/**/*.less",
    "src/**/*.json",
    "tests/**/*.js"
  ],
  "files": [
    "eslint.config.mjs",
    ".stylelintrc.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist_electron"
  ]
}