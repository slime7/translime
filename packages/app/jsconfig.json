{
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@pkg/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/renderer/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.vue",
    "src/**/*.css",
    "src/**/*.scss",
    "src/**/*.less",
    "src/**/*.json"
  ],
  "files": [
    ".eslintrc.js",
    ".stylelintrc.js",
    "components.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist_electron"
  ]
}
