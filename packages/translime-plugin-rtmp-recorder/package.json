{
  "name": "translime-plugin-rtmp-recorder",
  "version": "1.0.4",
  "description": "translime 插件：rtmp 流视频保存到文件",
  "license": "MIT",
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite -c ui.vite.config.mjs",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.mjs",
    "build": "npm run build:plugin && npm run build:ui"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "dayjs": "^1.11.9",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^10.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "translime-sdk": "workspace:*",
    "vite": "^8.2.0",
    "vite-plugin-css-injected-by-js": "^3.4.0",
    "vue": "^3.5.40",
    "vuetify": "^4.1.7"
  },
  "plugin": {
    "title": "直播录像",
    "description": "rtmp 流视频保存到文件",
    "ui": "dist/ui.esm.js"
  },
  "peerDependencies": {
    "electron": "~39.2.4",
    "vue": "^3.5.40",
    "vuetify": "^4.1.7"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18"
  }
}
