{
  "name": "translime-plugin-rtmp-recorder",
  "version": "1.0.3",
  "description": "translime 插件：rtmp 流视频保存到文件",
  "license": "MIT",
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite -c ui.vite.config.js",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.js",
    "build": "npm run build:plugin && npm run build:ui"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "dayjs": "^1.11.9",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^10.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "vite": "^6.3.2",
    "vite-plugin-css-injected-by-js": "^3.1.2",
    "vue": "^3.5.13",
    "vuetify": "^3.11.6"
  },
  "plugin": {
    "title": "直播录像",
    "description": "rtmp 流视频保存到文件",
    "ui": "dist/ui.esm.js"
  },
  "peerDependencies": {
    "electron": "~39.2.4",
    "vue": "^3.5.13",
    "vuetify": "^3.8.1"
  }
}