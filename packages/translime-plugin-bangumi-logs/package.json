{
  "name": "translime-plugin-bangumi-logs",
  "version": "1.1.0",
  "description": "Bangumi Logs plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slime7/translime.git",
    "directory": "packages/translime-plugin-bangumi-logs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "icon.svg"
  ],
  "scripts": {
    "dev": "vite build -c ui.vite.config.mjs --watch",
    "preview:ui": "vite -c ui.vite.config.mjs --mode preview",
    "prebuild": "pnpm --filter translime-sdk build",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.mjs",
    "build": "pnpm run build:plugin && pnpm run build:ui",
    "test": "pnpm exec vitest run -c vitest.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^10.11.1",
    "mde-vue": "git+https://github.com/slime7/mde-vue.git#v26.10.16",
    "translime-sdk": "workspace:*",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  },
  "plugin": {
    "title": "Bangumi Logs",
    "description": "Bangumi Logs",
    "icon": "./icon.svg",
    "//windowUrl": "dist/ui/index.html",
    "ui": "dist/ui.esm.js"
  },
  "engines": {
    "translime": ">=0.9.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.8.4",
    "tailwindcss": "^4.3.3"
  }
}
