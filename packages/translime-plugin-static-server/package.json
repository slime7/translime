{
  "name": "translime-plugin-static-server",
  "version": "2.2.1",
  "description": "开启一个临时的静态文件服务器。",
  "license": "MIT",
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/icon.png"
  ],
  "scripts": {
    "dev": "vite build -c ui.vite.config.mjs --watch",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.mjs",
    "build": "npm run build:plugin && npm run build:ui"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "detect-port": "^1.3.0",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^10.0.0",
    "serve-handler": "^6.1.5",
    "vite": "^8.0.0",
    "vite-plugin-css-injected-by-js": "^3.4.0",
    "vue": "^3.5.13",
    "vuetify": "^3.11.6"
  },
  "plugin": {
    "title": "static server",
    "description": "开启一个临时的静态文件服务器。",
    "icon": "./src/icon.png",
    "ui": "dist/ui.esm.js"
  },
  "peerDependencies": {
    "electron": "~39.2.4",
    "vue": "^3.5.13",
    "vuetify": "^3.8.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.8"
  }
}
