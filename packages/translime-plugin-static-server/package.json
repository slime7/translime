{
  "name": "translime-plugin-static-server",
  "version": "2.3.0",
  "description": "开启一个临时的静态文件服务器。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slime7/translime.git",
    "directory": "packages/translime-plugin-static-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src/icon.png"
  ],
  "scripts": {
    "dev": "vite build -c ui.vite.config.mjs --watch",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.mjs",
    "build": "npm run build:plugin && npm run build:ui"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "detect-port": "^1.3.0",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-extended": "^3.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^10.11.1",
    "serve-handler": "^6.1.5",
    "translime-sdk": "workspace:*",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vue": "^3.5.44"
  },
  "plugin": {
    "title": "static server",
    "description": "开启一个临时的静态文件服务器。",
    "icon": "./src/icon.png",
    "ui": "dist/ui.esm.js"
  },
  "engines": {
    "translime": ">=0.9.0"
  },
  "peerDependencies": {
    "electron": "~44.7.0",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
