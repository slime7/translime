{
  "name": "translime-plugin-namesilo-dns",
  "version": "1.0.3",
  "description": "namesilo动态dns设置",
  "license": "MIT",
  "keywords": [
    "translime",
    "translime-plugin"
  ],
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite -c ui.vite.config.js",
    "build:plugin": "vite build",
    "build:ui": "vite build -c ui.vite.config.js",
    "build": "pnpm run build:plugin && pnpm run build:ui"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.1.11",
    "autoprefixer": "^10.4.4",
    "axios": "^1.6.0",
    "eslint": "~9.24.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-preact": "^1.3.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "fast-xml-parser": "^4.0.7",
    "postcss": "^8.4.12",
    "preact": "^10.19.0",
    "semver-compare": "^1.0.0",
    "tailwindcss": "^3.0.23",
    "translime-sdk": "workspace:*",
    "vite": "^8.0.0"
  },
  "plugin": {
    "title": "namesilo dns",
    "description": "定时获取ip并设定为namesilo的域名解析",
    "windowUrl": "dist/ui.html"
  }
}
